			</textField>
			<textField>
				<reportElement uuid="970a22f2-5f9c-4fb7-bbc2-b9ff048f057d" x="366" y="3" width="100" height="20">
					<printWhenExpression><![CDATA[$F{credited_amount}>0]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$F{credited_amount}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="e7a9fe3a-02f6-4895-8569-4eb0fef4d458" x="366" y="3" width="100" height="20">
