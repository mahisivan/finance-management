<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SalaryReport" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="0fe7e1ea-4af3-4a2f-815b-4eadf51ace64">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Title" forecolor="#FFFFFF" fontName="Times New Roman" fontSize="50" isBold="false" pdfFontName="Times-Bold"/>
	<style name="SubTitle" forecolor="#CCCCCC" fontName="Times New Roman" fontSize="18" isBold="false" pdfFontName="Times-Roman"/>
	<style name="Column header" forecolor="#666666" fontName="Times New Roman" fontSize="14" isBold="true" pdfFontName="Times-Roman"/>
	<style name="Detail" mode="Transparent" fontName="Times New Roman" pdfFontName="Times-Roman"/>
	<style name="Row" mode="Transparent" fontName="Times New Roman" pdfFontName="Times-Roman">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F0EFEF"/>
		</conditionalStyle>
	</style>
	<parameter name="companyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="fromDate" class="java.lang.String"/>
	<parameter name="toDate" class="java.lang.String"/>
	<parameter name="imagesFolder" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT sl_no,salary_id,company_name,created_date,company_joining_date,designation_name,
designation_joining_date,salary_in_rs,salary_drawn,account_no
FROM get_salary_data($P{companyId},$P{fromDate},$P{toDate})]]>
	</queryString>
	<field name="sl_no" class="java.lang.Integer"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="designation_name" class="java.lang.String"/>
	<field name="created_date" class="java.sql.Date"/>
	<field name="salary_drawn" class="java.lang.Long"/>
	<field name="salary_in_rs" class="java.lang.String"/>
	<field name="account_no" class="java.lang.Long"/>
	<field name="designation_joining_date" class="java.util.Date"/>
	<field name="company_joining_date" class="java.util.Date"/>
	<field name="salary_id" class="java.lang.Integer"/>
	<variable name="salary_drawn_1" class="java.lang.Long" resetType="Group" resetGroup="companyGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{salary_drawn}]]></variableExpression>
	</variable>
	<group name="companyGroup">
		<groupExpression><![CDATA[$F{company_name}]]></groupExpression>
		<groupHeader>
			<band height="30">
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement mode="Opaque" x="7" y="6" width="546" height="20" forecolor="#0033CC" backcolor="#FFFFCC" uuid="6bd37b6c-2732-4a41-88fb-429bb45a250a"/>
					<textElement>
						<font fontName="Times New Roman" size="12" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["Company Name : "+$F{company_name}+" joined on "+$F{company_joining_date}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="25">
				<textField>
					<reportElement mode="Opaque" x="7" y="3" width="546" height="20" forecolor="#003399" backcolor="#CCCCFF" uuid="a139e2f1-cbe4-4450-86b4-9609bb93f022"/>
					<textElement textAlignment="Right">
						<font fontName="Times New Roman" size="12" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["Total Salary Drawn : "+$V{salary_drawn_1}+" Rs         "]]></textFieldExpression>
				</textField>
			</band>
		</groupFooter>
	</group>
	<group name="DesignationGroup">
		<groupExpression><![CDATA[$F{designation_name}]]></groupExpression>
		<groupHeader>
			<band height="28">
				<textField>
					<reportElement mode="Opaque" x="7" y="3" width="546" height="20" forecolor="#FF0066" backcolor="#FFCCCC" uuid="4cbf6458-bbb6-4d08-b95f-a8ae2a3d5724"/>
					<textElement>
						<font fontName="Times New Roman" size="12" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["Designation : "+$F{designation_name}+" with effect from :"+$F{designation_joining_date}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
	</group>
	<background>
		<band splitType="Stretch"/>
	</background>
